{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinguaIME",
  "version": "0.1.0",
  "identifier": "com.linguaime.desktop",
  "build": {
    "beforeDevCommand": "pnpm native:build && pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm native:build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LinguaIME · 输入，自然发生",
        "decorations": false,
        "shadow": true,
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../build/native/lingua_tsf.dll": "native/lingua_tsf.dll",
      "../build/native/lingua_runtime.dll": "native/lingua_runtime.dll",
      "../build/native/ime_ffi.dll": "native/ime_ffi.dll",
      "../build/native/rime/rime.dll": "native/rime/rime.dll",
      "../build/native/rime/manifest.json": "native/rime/manifest.json",
      "../build/native/rime/runtime-id.txt": "native/rime/runtime-id.txt",
      "../build/native/rime/data/build/*": "native/rime/data/build/",
      "../data/rime/LIBRIME-LICENSE.txt": "native/rime/data/LIBRIME-LICENSE.txt",
      "../data/rime/LICENSE": "native/rime/data/LICENSE",
      "../data/rime/AUTHORS": "native/rime/data/AUTHORS",
      "../scripts/register-ime.ps1": "native/register-ime.ps1",
      "../scripts/native-update.ps1": "native/native-update.ps1"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
