{
  "name": "lingua-ime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "vue-tsc --noEmit",
    "tauri": "tauri",
    "format": "node node_modules/prettier/bin/prettier.cjs --write src tests docs vite.config.ts playwright.config.ts eslint.config.mjs package.json index.html",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --locked --offline -- -D warnings && cargo test --workspace --locked --offline",
    "format:check": "node node_modules/prettier/bin/prettier.cjs --check src tests docs vite.config.ts playwright.config.ts eslint.config.mjs package.json index.html",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test:e2e": "node scripts/test-e2e.mjs",
    "native:unregister": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-ime.ps1 -Unregister",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "native:register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-ime.ps1"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@iconify-json/lucide": "1.2.146",
    "@iconify/vue": "5.0.3",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@vueuse/core": "15.0.0",
    "pinia": "4.1.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.0"
}
